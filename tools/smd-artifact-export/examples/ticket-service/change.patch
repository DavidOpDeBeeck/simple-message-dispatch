@@ -0,0 +1,28 @@
+package app.dodb.smd.ticket.drivenadapter.autoescalation;
+
+import app.dodb.smd.api.command.CommandGateway;
+import app.dodb.smd.api.event.EventHandler;
+import app.dodb.smd.api.event.ProcessingGroup;
+import app.dodb.smd.ticket.drivenadapter.DrivenAdapterConfiguration;
+import app.dodb.smd.ticket.drivingport.command.EscalateTicketCommand;
+import app.dodb.smd.ticket.drivingport.event.TicketOpenedEvent;
+import org.springframework.context.annotation.Lazy;
+import org.springframework.stereotype.Component;
+
+@Component
+@ProcessingGroup(DrivenAdapterConfiguration.AUTO_ESCALATION)
+public class AutoEscalationPolicy {
+
+    private final CommandGateway commandGateway;
+
+    public AutoEscalationPolicy(@Lazy CommandGateway commandGateway) {
+        this.commandGateway = commandGateway;
+    }
+
+    @EventHandler
+    public void on(TicketOpenedEvent event) {
+        if (event.title().toLowerCase().contains("urgent")) {
+            commandGateway.send(new EscalateTicketCommand(event.ticketId(), "urgent in title"));
+        }
+    }
+}
